   "source": [
    "# Carrega os dados da tabela silver.airline_delays do Supabase\n",
    "print(\"Carregando dados da camada Silver via JDBC...\")\n",
    "df_silver = spark.read.jdbc(\n",
    "    url=jdbc_url, \n",
    "    table=\"silver.airline_delays\", \n",
    "    properties=db_properties\n",
    ")\n",
    "\n",
    "df_silver.cache()\n",
    "print(f\"✓ Carregados {df_silver.count():,} registros da camada Silver.\")\n",
    "df_silver.printSchema()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "61a4796e",
   "metadata": {},
   "source": [
    "## 5. Transformar e Carregar Dimensões\n",
    "\n",
    "Cria e carrega as tabelas de dimensão `DIM_TME`, `DIM_CRE`, e `DIM_ARR` no Data Warehouse usando Spark."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dc27707d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- 1. Dimensão Tempo (DIM_TME) ---\n",
    "print(\"Preparando dimensão Tempo...\")\n",
    "dim_tme = df_silver.select(col(\"year\").alias(\"YAR\"), col(\"month\").alias(\"MNH\")).distinct()\\\n",
    "    .withColumn(\"TIS\", (((col(\"MNH\") - 1) / 3) + 1).cast(\"integer\"))\\\n",
    "    .withColumn(\"SMT\", when(col(\"MNH\") <= 6, 1).otherwise(2))\\\n",
    "    .withColumn(\"MES_NME\", expr(\"\"\"\n",
    "        CASE WHEN MNH = 1 THEN 'Janeiro' WHEN MNH = 2 THEN 'Fevereiro' WHEN MNH = 3 THEN 'Março'\n",
    "             WHEN MNH = 4 THEN 'Abril' WHEN MNH = 5 THEN 'Maio' WHEN MNH = 6 THEN 'Junho'\n",
    "             WHEN MNH = 7 THEN 'Julho' WHEN MNH = 8 THEN 'Agosto' WHEN MNH = 9 THEN 'Setembro'\n",
    "             WHEN MNH = 10 THEN 'Outubro' WHEN MNH = 11 THEN 'Novembro' ELSE 'Dezembro' END\n",
    "    \"\"\"))\\\n",
    "    .withColumn(\"MES_ANO\", concat(col(\"YAR\"), lit(\"-\"), format_string(\"%02d\", col(\"MNH\"))))\\\n",
    "    .withColumn(\"ANO_TIS\", concat(col(\"YAR\"), lit(\"-Q\"), col(\"TIS\")))\n",
    "\n",
    "dim_tme_final = dim_tme.select(\"YAR\", \"MNH\", \"TIS\", \"SMT\", \"MES_NME\", \"MES_ANO\", \"ANO_TIS\")\n",
    "\n",
    "print(\"Escrevendo dimensão Tempo (dw.DIM_TME)...\")\n",
    "dim_tme_final.write.jdbc(url=jdbc_url, table=\"dw.DIM_TME\", mode=\"overwrite\", properties=db_properties)\n",
    "print(\"✓ Dimensão Tempo escrita com sucesso.\")\n",
    "\n",
    "# --- 2. Dimensão Companhia Aérea (DIM_CRE) ---\n",
    "print(\"\\nPreparando dimensão Companhia Aérea...\")\n",
    "dim_cre = df_silver.select(col(\"carrier\").alias(\"CRE_CDE\"), col(\"carrier_name\").alias(\"CRE_NME\")).distinct()\n",
    "\n",
    "print(\"Escrevendo dimensão Companhia Aérea (dw.DIM_CRE)...\")\n",
    "dim_cre.write.jdbc(url=jdbc_url, table=\"dw.DIM_CRE\", mode=\"overwrite\", properties=db_properties)\n",
    "print(\"✓ Dimensão Companhia Aérea escrita com sucesso.\")\n",
    "\n",
    "# --- 3. Dimensão Aeroporto (DIM_ARR) ---\n",
    "print(\"\\nPreparando dimensão Aeroporto...\")\n",
    "dim_arr = df_silver.select(col(\"airport\").alias(\"ARR_CDE\"), col(\"airport_name\").alias(\"ARR_NME\")).distinct()\n",
    "\n",
    "print(\"Escrevendo dimensão Aeroporto (dw.DIM_ARR)...\")\n",
    "dim_arr.write.jdbc(url=jdbc_url, table=\"dw.DIM_ARR\", mode=\"overwrite\", properties=db_properties)\n",
    "print(\"✓ Dimensão Aeroporto escrita com sucesso.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "84a3bbab",
   "metadata": {},
   "source": [
    "## 6. Transformar e Carregar Tabela de Fatos\n",
    "\n",
    "Lê as dimensões para obter as `Surrogate Keys` e enriquece a tabela de fatos antes de carregá-la no Data Warehouse."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dda951a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- 4. Ler Dimensões com Surrogate Keys ---\n",
    "print(\"\\nLendo dimensões com Surrogate Keys do DW...\")\n",
    "dim_tme_sk = spark.read.jdbc(url=jdbc_url, table=\"dw.DIM_TME\", properties=db_properties)\n",
    "dim_cre_sk = spark.read.jdbc(url=jdbc_url, table=\"dw.DIM_CRE\", properties=db_properties)\n",
    "dim_arr_sk = spark.read.jdbc(url=jdbc_url, table=\"dw.DIM_ARR\", properties=db_properties)\n",
    "\n",
    "# --- 5. Preparar Tabela Fato (FCT_FIT_DLS) ---\n",
    "print(\"\\nPreparando tabela de fatos...\")\n",
    "\n",
    "# Joins para obter as Surrogate Keys\n",
    "fct_fit_dls = df_silver.join(\n",
    "    dim_tme_sk,\n",
    "    (df_silver[\"year\"] == dim_tme_sk[\"YAR\"]) & (df_silver[\"month\"] == dim_tme_sk[\"MNH\"]),\n",
    "    \"inner\"\n",
    ").join(\n",
    "    dim_cre_sk,\n",
    "    df_silver[\"carrier\"] == dim_cre_sk[\"CRE_CDE\"],\n",
    "    \"inner\"\n",
    ").join(\n",
    "    dim_arr_sk,\n",
    "    df_silver[\"airport\"] == dim_arr_sk[\"ARR_CDE\"],\n",
    "    \"inner\"\n",
    ")\n",
    "\n",
    "# Cálculos de métricas\n",
    "fct_fit_dls = fct_fit_dls.fillna(0) # Trata nulos antes de calcular\n",
    "fct_fit_dls = fct_fit_dls.withColumn(\"DLY_RTE\", when(col(\"arr_flights\") > 0, spark_round((col(\"arr_del15\") / col(\"arr_flights\")) * 100, 2)).otherwise(0)) \\\n",
    "    .withColumn(\"CNL_RTE\", when(col(\"arr_flights\") > 0, spark_round((col(\"arr_cancelled\") / col(\"arr_flights\")) * 100, 2)).otherwise(0)) \\\n",
    "    .withColumn(\"DVS_RTE\", when(col(\"arr_flights\") > 0, spark_round((col(\"arr_diverted\") / col(\"arr_flights\")) * 100, 2)).otherwise(0)) \\\n",
    "    .withColumn(\"AVG_DLY_MNE\", when(col(\"arr_flights\") > 0, spark_round(col(\"arr_delay\") / col(\"arr_flights\"), 2)).otherwise(0))\n",
    "\n",
    "fct_fit_dls = fct_fit_dls.withColumn(\"ONT_RTE\", 100 - col(\"DLY_RTE\"))\n",
    "\n",
    "# Seleção final e renomeação de colunas para a tabela fato\n",
    "fct_fit_dls_final = fct_fit_dls.select(\n",
    "    col(\"SRK_CRE\"),\n",
    "    col(\"SRK_ARR\"),\n",
    "    col(\"SRK_TME\"),\n",
    "    col(\"arr_flights\").alias(\"ARR_FIT\"),\n",
    "    col(\"arr_del15\").alias(\"ARR_DEL\"),\n",
    "    col(\"arr_cancelled\").alias(\"ARR_CNL\"),\n",
    "    col(\"arr_diverted\").alias(\"ARR_DVR\"),\n",
    "    col(\"arr_delay\").alias(\"ARR_DLY\"),\n",
    "    col(\"carrier_ct\").alias(\"CRE_CT\"),\n",
    "    col(\"weather_ct\").alias(\"WAE_CT\"),\n",
    "    col(\"nas_ct\").alias(\"NAS_CT\"),\n",
    "    col(\"security_ct\").alias(\"SCR_CT\"),\n",
    "    col(\"late_aircraft_ct\").alias(\"LTE_ARA_CT\"),\n",
    "    col(\"carrier_delay\").alias(\"CRE_DLY\"),\n",
    "    col(\"weather_delay\").alias(\"WAE_DLY\"),\n",
    "    col(\"nas_delay\").alias(\"NAS_DLY\"),\n",
    "    col(\"security_delay\").alias(\"SCR_DLY\"),\n",
    "    col(\"late_aircraft_delay\").alias(\"LTE_ARA_DLY\"),\n",
    "    col(\"DLY_RTE\"),\n",
    "    col(\"CNL_RTE\"),\n",
    "    col(\"DVS_RTE\"),\n",
    "    col(\"AVG_DLY_MNE\"),\n",
    "    col(\"ONT_RTE\")\n",
    ")\n",
    "\n",
    "# --- 6. Escrever Tabela Fato ---\n",
    "print(\"\\nEscrevendo tabela de fatos (dw.FCT_FIT_DLS)...\")\n",
    "fct_fit_dls_final.write.jdbc(url=jdbc_url, table=\"dw.FCT_FIT_DLS\", mode=\"append\", properties=db_properties)\n",
    "\n",
    "print(f\"✓ Carga Spark finalizada com sucesso no Supabase!\")\n",
    "print(f\"Registros processados: {fct_fit_dls_final.count()}\")"
   ]
  }
 ],,
