   "source": [
    "# Inicializa o Spark com suporte ao driver do Postgres\n",
    "spark = SparkSession.builder \\\n",
    "    .appName(\"ETL_Silver_to_Gold_Supabase\") \\\n",
    "    .config(\"spark.jars.packages\", \"org.postgresql:postgresql:42.7.1\") \\\n",
    "    .getOrCreate()\n",
    "\n",
    "print(\"✓ Sessão Spark iniciada com o driver PostgreSQL.\")"
   ]
  },
